# ---- Binaries ------------------------------------------------------------
# Any APK outside dist/ is a build artifact.
*.apk
*.aab
*.ap_

# dist/ holds the download the README points at, so exactly one release APK
# is tracked. Bump this line when versionName changes.
/dist/*.apk
!/dist/AutoClick-1.6.5.apk

